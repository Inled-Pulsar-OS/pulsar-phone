<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/desktopVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/streamLoadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@android:color/white"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvStreamLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/starting_pc_stream"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Top floating bar with back button and stream info -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/streamTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#80000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnBackStream"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_app"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvStreamTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Pulsar PC (Pantalla + Sonido)"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
