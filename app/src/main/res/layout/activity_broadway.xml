<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/broadwayWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating controls pill -->
    <LinearLayout
        android:id="@+id/floatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/ic_launcher_round"
        android:backgroundTint="#CC1E293B"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/broadwayAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:text="App Broadway"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnToggleKeyboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/keyboard_toggle"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnCloseBroadway"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_app"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#EF4444" />

    </LinearLayout>

</FrameLayout>
