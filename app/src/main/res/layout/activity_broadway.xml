<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <WebView
        android:id="@+id/broadwayWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- Material 3 Loading View: displays until Broadway app actually renders -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/loadingAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/loading_app_default"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/loadingAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/connecting_broadway"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Top floating Material 3 controls pill -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/broadwayAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:text="App"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurface" />

            <!-- Mode Selector: Select / Click vs Pan / Zoom -->
            <ImageButton
                android:id="@+id/btnToggleMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/interaction_mode"
                android:src="@drawable/ic_touch_pointer"
                app:tint="?attr/colorOnSurface" />

            <!-- Toggle Zoom Level / Reset Fit -->
            <ImageButton
                android:id="@+id/btnToggleZoom"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_label"
                android:src="@drawable/ic_zoom_fit"
                app:tint="?attr/colorOnSurface" />

            <!-- Keyboard Toggle -->
            <ImageButton
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/keyboard_toggle"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="?attr/colorOnSurface" />

            <!-- Close App -->
            <ImageButton
                android:id="@+id/btnCloseBroadway"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_app"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="?attr/colorError" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Native Soft Keyboard Input Bar (Guarantees Android Virtual Keyboard Opens Every Time) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nativeInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <EditText
                android:id="@+id/etNativeInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/type_to_send_hint"
                android:imeOptions="actionSend"
                android:inputType="text|textCapSentences"
                android:maxLines="2"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSendText"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_send"
                android:src="@android:drawable/ic_menu_send"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btnCloseInputBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_keyboard"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
