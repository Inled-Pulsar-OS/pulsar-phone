<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Edge-to-edge full bleed background with Pulsar Adblocker gradient (#3584e4 -> #9141ac -> #e01b24) -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#3584e4" android:offset="0.0"/>
                <item android:color="#9141ac" android:offset="0.5"/>
                <item android:color="#e01b24" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lucide Smartphone Icon - Scaled to fill the icon prominently -->
    <!-- Outer phone body (Lucide rect rx="2" ry="2" scaled) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M38,18 L70,18 A9,9 0 0,1 79,27 L79,81 A9,9 0 0,1 70,90 L38,90 A9,9 0 0,1 29,81 L29,27 A9,9 0 0,1 38,18 Z"/>

    <!-- Lucide Speaker / Camera Top Slit -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M49,27 L59,27"/>

    <!-- Lucide Home Indicator / Navigation Dot (M12 18h.01) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,81 L54.01,81"/>

</vector>
