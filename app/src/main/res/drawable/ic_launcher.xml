<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Edge-to-edge full bleed background with Pulsar Adblocker gradient (#3584e4 -> #9141ac -> #e01b24) -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#3584e4" android:offset="0.0"/>
                <item android:color="#9141ac" android:offset="0.5"/>
                <item android:color="#e01b24" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lucide Smartphone Icon - Scaled safely inside circle bounds (never clipped) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M46,32 L62,32 A5,5 0 0,1 67,37 L67,71 A5,5 0 0,1 62,76 L46,76 A5,5 0 0,1 41,71 L41,37 A5,5 0 0,1 46,32 Z"/>

    <!-- Lucide Speaker / Top Ear-piece Slit -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M51,37 L57,37"/>

    <!-- Lucide Home Indicator / Navigation Dot -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,71 L54.01,71"/>

</vector>
